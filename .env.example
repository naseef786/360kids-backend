PORT=4000
WEB_ORIGIN=http://localhost:3000
# Database/auth are not connected in this starter.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Optional custom CA path. Supabase hosts use the bundled public root by default.
DATABASE_CA_CERT=
# WhatsApp transport is not implemented. Keep secrets server-side.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Keep false until finance recipient/verifier rules and production roles are approved.
FINANCE_WORKFLOW_ENABLED=false
