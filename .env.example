PORT=4000
WEB_ORIGIN=http://localhost:3000
# Database/auth are not connected in this starter.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Optional custom CA path. Supabase hosts use the bundled public root by default.
DATABASE_CA_CERT=
# Outbound transactional email. Disabled until the mailbox password, TLS and
# a controlled delivery test are verified; never use a public/client env var.
EMAIL_DELIVERY_MODE=disabled
EMAIL_SMTP_HOST=mail.360kidsactivity.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=customerservice@360kidsactivity.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=customerservice@360kidsactivity.com
CONTACT_ACK_ENABLED=false
# WhatsApp transport is not implemented. Keep secrets server-side.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Keep false until finance recipient/verifier rules and production roles are approved.
FINANCE_WORKFLOW_ENABLED=false
# Staging-only Stripe Checkout test transport. Never set a live key here.
APP_ENV=development
STRIPE_TEST_ENABLED=false
STRIPE_TEST_PROJECT_REF=
STRIPE_TEST_SECRET_KEY=
