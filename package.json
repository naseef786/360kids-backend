{
  "name": "360kids-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/app.test.ts test/whatsapp-policy.test.ts test/platform.test.ts test/age.test.ts test/realtime.test.ts test/audit.test.ts test/auth.test.ts test/http-flow.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "worker": "node --import tsx src/worker.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/naseef786/360kids-backend.git"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
